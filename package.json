{
  "name": "teduh", "private": true, "version": "1.0.0", "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build && tsx scripts/build-worker.ts",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:a11y": "node scripts/accessibility.mjs",
    "verify:client": "node scripts/verify-client.mjs"
  },
  "dependencies": {
    "@fontsource/lora": "^5.2.0", "@fontsource/nunito-sans": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0", "tailwindcss": "^4.1.0",
    "dotenv": "^17.0.0", "express": "^5.1.0", "helmet": "^8.1.0",
    "lucide-react": "^0.468.0", "react": "^19.1.0", "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0", "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0", "@types/node": "^24.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0", "concurrently": "^9.2.0", "esbuild": "^0.25.0",
    "eslint": "^9.30.0", "eslint-plugin-react-hooks": "^5.2.0", "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0", "jsdom": "^26.1.0", "lighthouse": "^12.8.0",
    "tsx": "^4.20.0", "typescript": "~5.8.3", "typescript-eslint": "^8.35.0", "vite": "^6.3.0", "vitest": "^3.2.0"
  }
