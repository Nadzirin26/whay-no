# demo tidak mengirim pesan ke penyedia mana pun. Ganti ke openai / openai-compatible.
LLM_PROVIDER=demo
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Hanya untuk openai-compatible; URL HTTPS tepercaya, diatur operator server.
LLM_BASE_URL=https://api.openai.com/v1
PORT=3001
# Express di belakang reverse proxy: isi jumlah hop proxy tepercaya, jangan gunakan true.
TRUST_PROXY_HOPS=0
